	column TRIMESTRE
		lineageTag: 995b68a5-e2c4-4b6a-a379-591d1c5f19d1
		summarizeBy: none
		isNameInferred
		sourceColumn: [TRIMESTRE]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
				ADDCOLUMNS(
				        CALENDAR(MIN(Fact_Produccion[Fecha]),MAX(Fact_Produccion[Fecha])),
				        "AÑO",YEAR([Date]),
				        "MES_LETRA",FORMAT([DATE],"MMMM"),
				        "MES_NUMERO",MONTH([Date]),
				        "TRIMESTRE","T"&QUARTER([DATE]))
				
				```

	annotation PBI_Id = f4db0349d293458180e70c9f4ed8989c

