table Fact_Produccion
	lineageTag: d0b34b09-2a42-4ee1-b472-223a1362936e

	measure 'TOTAL KG PROCESADOS' = SUM(Fact_Produccion[KgEntrada])
		formatString: #,0.00
		lineageTag: a33bb4f9-acf7-4635-a5be-a3a6283c2018

	measure 'TOTAL KG MERMA' = SUM(Fact_Produccion[Merma_Kg])
		formatString: #,0.00
		lineageTag: 765fc882-f617-491b-abd8-2b9d04ff2873

	measure 'MERMA %' = DIVIDE([TOTAL KG MERMA],[TOTAL KG PROCESADOS],BLANK())
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 8e303375-3c22-4b36-b693-674df8f683ab

	measure 'KG PRODUCIDOS' = SUM(Fact_Produccion[KgSalida])
		formatString: #,0.00
		lineageTag: d80b9dc9-74a2-433e-92da-3cc3e971de3c

	measure RENDIMIENTO_% = DIVIDE(Fact_Produccion[KG PRODUCIDOS],Fact_Produccion[TOTAL KG PROCESADOS],BLANK())
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c08ecb6a-c1a0-4cbe-841b-393b21cbcfe1

	measure 'MERMA % AñoAnterior' = CALCULATE([MERMA %],SAMEPERIODLASTYEAR(Calendario[Date]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 035b5939-f611-433f-8f81-7a9e53ebae2d

	measure '% DIF AÑO ANTERIOR EN MERMA' = [MERMA %]-[MERMA % AñoAnterior]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 564b836d-008a-4c64-9292-e89e2e13bc11

